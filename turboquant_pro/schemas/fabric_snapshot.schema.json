{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ahb-sjsu/turboquant-pro/master/turboquant_pro/schemas/fabric_snapshot.schema.json",
  "title": "TurboQuant Pro NATS fabric snapshot",
  "description": "One read-only poll of a NATS server's monitoring port (turboquant_pro.console.fabric, `tqp fabric`): the server's counters (measured), rates since the previous poll (derived), leaf-node links and client connections with the subjects they subscribe to, JetStream totals, per-section read errors, and events since the previous poll. Contains no message content. schema_version 1.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "source",
    "t",
    "as_of_utc",
    "reachable",
    "interval_s",
    "server",
    "rates",
    "leafs",
    "connections",
    "jetstream",
    "errors",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "turboquant-pro/fabric-snapshot"
    },
    "schema_version": {
      "const": 1
    },
    "invocation": {
      "description": "How this artifact was produced (every tqp JSON document carries it); identical to invocation.schema.json.",
      "type": "object",
      "required": [
        "argv",
        "cwd",
        "tool_version",
        "git_commit",
        "git_dirty",
        "python",
        "created_utc"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The command, program name first (tqp)."
        },
        "cwd": {
          "type": "string",
          "description": "Working directory the command ran in; relative paths in argv resolve against it."
        },
        "tool_version": {
          "type": "string"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commit of the turboquant_pro source that ran; null for an installed package (the version identifies the code)."
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when that source had uncommitted changes, so the commit alone does not reproduce it; null when unknown."
        },
        "python": {
          "type": "string"
        },
        "created_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "redacted"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "redacted": {
          "type": "boolean",
          "description": "IP addresses replaced by a short hash."
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "uptime_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "t": {
      "type": "number",
      "description": "Unix time of the poll."
    },
    "as_of_utc": {
      "type": "string"
    },
    "reachable": {
      "type": "boolean"
    },
    "interval_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "Seconds since the previous comparable poll; null on the first poll or after a server restart."
    },
    "server": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "connections": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_connections": {
          "type": [
            "integer",
            "null"
          ]
        },
        "leafnodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "subscriptions": {
          "type": [
            "integer",
            "null"
          ]
        },
        "slow_consumers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mem_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "in_msgs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "out_msgs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "in_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "out_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "rates": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "leafs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ip",
          "port",
          "rtt_ms",
          "subjects",
          "rates"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "account": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "is_spoke": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "rtt_ms": {
            "type": [
              "number",
              "null"
            ],
            "description": "Sampled: the server's last PING round trip."
          },
          "rtt_unchanged_s": {
            "type": [
              "number",
              "null"
            ],
            "description": "Seconds this monitor has seen the same rtt value: the server refreshes it when it PINGs the link, so a long-unchanged value may be old. Null the first time the link is seen."
          },
          "in_msgs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "out_msgs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "in_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "out_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "subscriptions": {
            "type": [
              "integer",
              "null"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compression": {
            "type": [
              "string",
              "null"
            ]
          },
          "rates": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": "Per-second change of each counter since the last poll (derived); null on a first poll, after a counter reset, or for a link that is new."
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cid",
          "subjects",
          "rates"
        ],
        "properties": {
          "cid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "rtt_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "uptime_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "idle_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "in_msgs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "out_msgs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "in_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "out_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pending_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rates": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": "Per-second change of each counter since the last poll (derived); null on a first poll, after a counter reset, or for a link that is new."
          }
        }
      }
    },
    "jetstream": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "streams": {
          "type": [
            "integer",
            "null"
          ]
        },
        "consumers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "messages": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stream_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "messages": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "consumers": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Endpoint -> why it could not be read (or what was left out)."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail"
        ],
        "properties": {
          "kind": {
            "enum": [
              "server_unreachable",
              "server_restarted",
              "slow_consumers",
              "leaf_connected",
              "leaf_disconnected",
              "counter_reset"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
