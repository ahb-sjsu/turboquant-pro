{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ahb-sjsu/turboquant-pro/master/turboquant_pro/schemas/rank_certificate.schema.json",
  "title": "TurboQuant Pro rank certificate",
  "description": "The provenance-stamped JSON artifact emitted by `tqp certify` (and the plan-embeddings certificate preview). Distribution-free rank-fidelity floors plus the inputs, params, and decision that produced them. schema_version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "tool_version",
    "created_utc",
    "inputs",
    "params",
    "certificate",
    "interpretation",
    "passed"
  ],
  "properties": {
    "schema": {
      "const": "turboquant-pro/rank-certificate",
      "description": "Stable format identifier."
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Bumped only for a breaking change; additive fields do not bump it."
    },
    "tool_version": {
      "type": "string",
      "description": "turboquant-pro package version that produced the certificate."
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "reconstructed"
      ],
      "properties": {
        "original": {
          "$ref": "#/$defs/inputRef"
        },
        "reconstructed": {
          "$ref": "#/$defs/inputRef"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "n_anchors",
        "seed"
      ],
      "properties": {
        "metric": {
          "enum": [
            "cosine",
            "l2"
          ],
          "description": "Ranking distance used to sample anchor pairs."
        },
        "n_anchors": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kappa",
        "mu_hat",
        "tau_floor",
        "spearman_floor",
        "n_pairs",
        "max_certifiable_kappa",
        "vacuous"
      ],
      "properties": {
        "kappa": {
          "$ref": "#/$defs/finiteOrNull",
          "description": "Robust multiplicative distortion of pairwise distances."
        },
        "mu_hat": {
          "$ref": "#/$defs/finiteOrNull",
          "description": "Corpus distance-ratio concentration at kappa."
        },
        "tau_floor": {
          "$ref": "#/$defs/finiteOrNull",
          "description": "Guaranteed Kendall tau floor (1 - 2*mu_hat)."
        },
        "spearman_floor": {
          "$ref": "#/$defs/finiteOrNull",
          "description": "Guaranteed Spearman rho floor (1 - 3*mu_hat)."
        },
        "n_pairs": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of anchor pairs measured."
        },
        "max_certifiable_kappa": {
          "$ref": "#/$defs/finiteOrNull"
        },
        "vacuous": {
          "type": "boolean",
          "description": "True when no finite distortion certifies rank on this corpus (exact reranking required)."
        }
      }
    },
    "interpretation": {
      "type": "string",
      "description": "Human-readable one-line verdict."
    },
    "passed": {
      "type": "boolean",
      "description": "Gate outcome: a positive floor (or tau_floor >= --min-tau when given)."
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional: the declared downstream consumer the certificate is judged for.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional: the software/hardware that produced the certificate.",
      "properties": {
        "tool_version": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "numpy": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional: what the certificate depends on, recorded at issue so `tqp verify --data` can later find it no longer applicable (docs/DESIGN_certificate_expiry.md).",
      "required": ["issued_for", "thresholds"],
      "properties": {
        "issued_for": {
          "type": "object",
          "properties": {
            "observer_sha256": {"type": ["string", "null"]},
            "reference_provider": {"type": ["string", "null"]},
            "operator_sha256": {"type": ["string", "null"]}
          }
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "min_operator_overlap": {"type": "number"},
            "max_coverage_divergence": {"type": "number"}
          }
        },
        "operator_sketch": {
          "type": ["object", "null"],
          "properties": {
            "dim": {"type": "integer"},
            "rank": {"type": "integer"},
            "effective_rank": {"type": "number"},
            "trace": {"type": "number"},
            "trace_fraction": {"type": "number"},
            "eigenvalues": {"type": "array", "items": {"type": "number"}},
            "basis": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
          }
        },
        "coverage_sketch": {
          "type": ["object", "null"],
          "properties": {
            "rows": {"type": "integer"},
            "dim": {"type": "integer"},
            "mean": {"type": "array", "items": {"type": "number"}},
            "variance": {"type": "array", "items": {"type": "number"}}
          }
        },
        "strata_sketch": {
          "type": ["object", "null"],
          "description": "Phase 2: the certified sample's areas (centroids from even rows; row counts and conformal radii from odd rows) so later data in regions the certificate did not cover is found.",
          "required": ["assignment", "rows", "n_min", "radius_quantile", "baseline_uncovered", "tolerance", "areas"],
          "properties": {
            "area_map_sha256": {"type": ["string", "null"]},
            "assignment": {"const": "nearest-centroid"},
            "split": {"type": "string"},
            "rows": {"type": "integer", "minimum": 0},
            "n_min": {"type": "integer", "minimum": 1},
            "radius_quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "baseline_uncovered": {"type": "number", "minimum": 0},
            "tolerance": {"type": "number", "minimum": 0},
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "rows", "covered", "radius", "centroid"],
                "properties": {
                  "name": {"type": "string"},
                  "rows": {"type": "integer", "minimum": 0},
                  "covered": {"type": "boolean"},
                  "radius": {"type": ["number", "null"], "minimum": 0},
                  "centroid": {"type": "array", "items": {"type": "number"}}
                }
              }
            }
          }
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional: the observer contract (tqp-observer/1) this artifact was computed for, named by content hash so a mismatch can be refused. See docs/DESIGN_observer_contracts.md.",
      "required": ["profile", "observer", "sha256"],
      "properties": {
        "profile": {"const": "tqp-observer/1"},
        "observer": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target": {"type": "string"},
        "consumers": {"type": "array", "items": {"type": "string"}},
        "primary_consumer": {
          "type": "object",
          "properties": {"metric": {"type": "string"}, "config": {"type": "object"}, "weight": {"type": "number"}}
        }
      }
    },
    "limitations": {
      "type": "array",
      "description": "Optional: scope caveats \u00e2\u20ac\u201d what this certificate does NOT cover.",
      "items": {
        "type": "string"
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which read operator a consumer-relative number was computed against. Two defensible references for one attention head differ by about 0.3 in subspace overlap, so a consumer-relative figure is not interpretable unless it names its reference.",
      "required": [
        "provider",
        "exact",
        "dim",
        "operator_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "description": "Registered read-operator provider name."
        },
        "exact": {
          "type": "boolean",
          "description": "True when the operator is a closed form rather than an estimate."
        },
        "description": {
          "type": "string"
        },
        "dim": {
          "type": "integer",
          "minimum": 1
        },
        "operator_sha256": {
          "type": "string",
          "description": "Hash of the operator's bytes; binds the number to the exact P_C used."
        },
        "trace": {
          "type": [
            "number",
            "null"
          ]
        },
        "effective_rank": {
          "type": [
            "number",
            "null"
          ]
        },
        "consumer_distortion": {
          "type": [
            "number",
            "null"
          ],
          "description": "tr(P_C @ Sigma_delta) between the two inputs."
        },
        "reconstruction_distortion": {
          "type": [
            "number",
            "null"
          ],
          "description": "tr(Sigma_delta), the identity-reference value, for contrast."
        },
        "config": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "shape",
        "dtype",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "finiteOrNull": {
      "type": [
        "number",
        "null"
      ],
      "description": "A finite measurement, or null when it was non-finite (e.g. NaN on a degenerate corpus). Bare NaN/Infinity are never emitted."
    }
  }
}
